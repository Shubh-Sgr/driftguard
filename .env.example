# DriftGuard connects ONLY with the read-only role created in docker/seed/00_roles.sql.
# These are local Docker test credentials, not secrets.
SOURCE_DATABASE_URL=postgres://driftguard_ro:driftguard_ro_local@localhost:5433/fintech
TARGET_DATABASE_URL=postgres://driftguard_ro:driftguard_ro_local@localhost:5434/fintech

# Hard cap on any single query DriftGuard runs (milliseconds).
DRIFTGUARD_STATEMENT_TIMEOUT_MS=30000
