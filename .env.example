# PgVouch connects ONLY with the read-only role created in docker/seed/00_roles.sql.
# These are local Docker test credentials, not secrets.
SOURCE_DATABASE_URL=postgres://pgvouch_ro:pgvouch_ro_local@localhost:5433/fintech
TARGET_DATABASE_URL=postgres://pgvouch_ro:pgvouch_ro_local@localhost:5434/fintech

# Hard cap on any single query PgVouch runs (milliseconds).
PGVOUCH_STATEMENT_TIMEOUT_MS=30000

# Planner LLM (F7): none (rules-only, default) | ollama (local) | gemini (free tier).
# With none, nothing is ever sent to a model.
PGVOUCH_LLM=none
OLLAMA_MODEL=llama3.2
# GEMINI_API_KEY=

# Accept an LLM plan only after a passing shadow run (needs Docker): on (default) | off.
PGVOUCH_SHADOW_VERIFY=on
